# Copy this file to .env.local and fill it in. .env.local is git-ignored.
# Find both values in the Supabase dashboard: Project Settings -> API Keys / Data API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The *publishable* key (starts with sb_publishable_). Never put the secret or service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
